SPRING_PROFILES_ACTIVE=http
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Disable only for trusted local use.
MCP_AUTH_ENABLED=true
# Host interface for the published port. Use an HTTPS proxy for remote access.
MCP_BIND_ADDRESS=127.0.0.1
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=OPTIONAL_DEFAULT_SERVER_ID

# Optional browser login for OAuth clients, including ChatGPT and Codex.
MCP_OAUTH_ENABLED=false
# Public HTTPS origin, without a trailing slash. The proxy must route the entire origin.
MCP_OAUTH_ISSUER=https://discord-mcp.example.com
MCP_OAUTH_USERNAME=
# Plain text, 16-256 characters. Quote values containing $ or # in your .env file.
MCP_OAUTH_PASSWORD=
MCP_OAUTH_ACCESS_TOKEN_SECONDS=900
# Sliding lifetime: each successful refresh starts another 90-day period.
MCP_OAUTH_REFRESH_TOKEN_DAYS=90
# Compose uses its named volume. For a manual Java deployment, set this to durable storage.
# MCP_OAUTH_DATA_DIR=./data/oauth
